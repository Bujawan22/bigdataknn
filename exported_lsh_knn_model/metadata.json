{
    "model_name": "DDoS SDN Detection using Spark LSH-KNN",
    "label_col": "label",
    "feature_cols": [
        "pktcount",
        "bytecount",
        "dur",
        "dur_nsec",
        "tot_dur",
        "flows",
        "packetins",
        "pktperflow",
        "byteperflow",
        "pktrate",
        "Pairflow",
        "port_no",
        "tx_bytes",
        "rx_bytes",
        "tx_kbps",
        "rx_kbps",
        "tot_kbps",
        "Protocol_index"
    ],
    "numeric_cols": [
        "pktcount",
        "bytecount",
        "dur",
        "dur_nsec",
        "tot_dur",
        "flows",
        "packetins",
        "pktperflow",
        "byteperflow",
        "pktrate",
        "Pairflow",
        "port_no",
        "tx_bytes",
        "rx_bytes",
        "tx_kbps",
        "rx_kbps",
        "tot_kbps"
    ],
    "categorical_cols": [
        "src",
        "dst",
        "Protocol"
    ],
    "indexed_cols": [
        "src_index",
        "dst_index",
        "Protocol_index"
    ],
    "parameters": {
        "k": 3,
        "bucket_length": 1.0,
        "num_hash_tables": 2,
        "prediction_sample_size": 5000,
        "distance_threshold": 1.5,
        "lsh_train_fraction": 0.35,
        "balanced_prediction_sample": true,
        "seed": 42
    },
    "metrics": {
        "accuracy": 0.954,
        "precision": 0.970954356846473,
        "recall": 0.936,
        "f1_score": 0.9531568228105907
    }
}